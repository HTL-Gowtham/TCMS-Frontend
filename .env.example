# Copy this file to .env and fill in the values
VITE_API_BASE_URL=

# Microsoft SSO (frontend public config)
VITE_SSO_MICROSOFT_CLIENT_ID=
VITE_SSO_MICROSOFT_TENANT_ID=common
VITE_SSO_MICROSOFT_REDIRECT_URI=http://localhost:5173/login
VITE_SSO_MICROSOFT_SCOPE=openid profile email User.Read
VITE_SSO_MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
VITE_SSO_MICROSOFT_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
# Optional comma-separated domain allow-list, example: contoso.com,fabrikam.com
VITE_SSO_ALLOWED_EMAIL_DOMAINS=
